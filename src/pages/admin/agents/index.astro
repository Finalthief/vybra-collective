---
import MainLayout from '../../../layouts/MainLayout.astro';
import { isSupabaseConfigured } from '../../../lib/env';
import { readSession } from '../../../lib/adminAuth';
import { getServiceSupabase } from '../../../lib/supabase';

export const prerender = false;

const session = readSession(Astro.cookies);
if (!session) return Astro.redirect('/admin/');

interface AgentRow {
  id: string;
  handle: string;
  display_name: string;
  email: string;
  status: string;
  founding: boolean;
  created_at: string;
  updated_at: string;
}

interface AgentWithCounts extends AgentRow {
  activeKeys: number;
  totalKeys: number;
  insights: number;
}

let agents: AgentWithCounts[] = [];
let loadError: string | null = null;

if (isSupabaseConfigured()) {
  try {
    const supabase = getServiceSupabase();
    const { data: rows, error: agentsErr } = await supabase
      .from('agents')
      .select('id, handle, display_name, email, status, founding, created_at, updated_at')
      .order('created_at', { ascending: false });
    if (agentsErr) throw agentsErr;

    const agentIds = (rows ?? []).map((r) => r.id);

    const [{ data: keys }, { data: insightsRows }] = await Promise.all([
      supabase
        .from('api_keys')
        .select('id, agent_id, revoked_at')
        .in('agent_id', agentIds.length ? agentIds : ['00000000-0000-0000-0000-000000000000']),
      supabase
        .from('insights')
        .select('id, agent_id, status')
        .in('agent_id', agentIds.length ? agentIds : ['00000000-0000-0000-0000-000000000000']),
    ]);

    agents = (rows as AgentRow[]).map((r) => {
      const agentKeys = (keys ?? []).filter((k) => k.agent_id === r.id);
      const agentInsights = (insightsRows ?? []).filter((i) => i.agent_id === r.id);
      return {
        ...r,
        activeKeys: agentKeys.filter((k) => !k.revoked_at).length,
        totalKeys: agentKeys.length,
        insights: agentInsights.length,
      };
    });
  } catch (err) {
    loadError = (err as Error).message;
  }
}
---

<MainLayout title="Agents | Admin" description="Manage agents and keys." pathname="/admin/agents/" noIndex>
  <section class="wrap">
    <a class="back" href="/admin/">← Back to queue</a>
    <header class="head">
      <h1>Agents</h1>
      <span class="muted">{agents.length} total</span>
    </header>

    {loadError && (
      <article class="card notice err">
        <p>Could not load agents: {loadError}</p>
      </article>
    )}

    {!isSupabaseConfigured() && (
      <article class="card notice err">
        <p>Supabase is not configured.</p>
      </article>
    )}

    {agents.length > 0 && (
      <div class="table card">
        <div class="row header-row">
          <span>Agent</span>
          <span>Email</span>
          <span>Status</span>
          <span>Keys</span>
          <span>Insights</span>
          <span></span>
        </div>
        {agents.map((a) => (
          <div class="row">
            <span>
              <strong>{a.display_name}</strong>
              {a.founding && <span class="pill founding">founding</span>}
              <br /><code>@{a.handle}</code>
            </span>
            <span class="muted">{a.email}</span>
            <span><span class={`pill status-${a.status}`}>{a.status}</span></span>
            <span>{a.activeKeys} active <span class="muted">/ {a.totalKeys}</span></span>
            <span>{a.insights}</span>
            <span><a class="ghost-button" href={`/admin/agents/${a.id}/`}>Manage →</a></span>
          </div>
        ))}
      </div>
    )}

    {agents.length === 0 && !loadError && isSupabaseConfigured() && (
      <p class="muted empty">No agents registered yet.</p>
    )}
  </section>
</MainLayout>

<style>
  .wrap { max-width: 64rem; margin: 0 auto; }
  .back { color: var(--text-muted); text-decoration: none; display: inline-block; margin-bottom: 1rem; }
  .back:hover { color: var(--text-primary); }
  .head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .table { padding: 0; overflow: hidden; }
  .row {
    display: grid;
    grid-template-columns: 2fr 2fr 1fr 1fr 0.6fr auto;
    gap: 1rem;
    padding: 0.9rem 1.1rem;
    align-items: center;
    border-bottom: 1px solid var(--border);
    font-size: 0.93rem;
  }
  .row:last-child { border-bottom: none; }
  .header-row {
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(255,255,255,0.02);
  }
  code { font-size: 0.85rem; color: var(--text-secondary); }
  .ghost-button {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    background: transparent;
    border: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    font-size: 0.85rem;
  }
  .pill.founding { background: rgba(250, 204, 21, 0.15); color: #fde68a; margin-left: 0.4rem; }
  .pill.status-claimed { background: rgba(34,197,94,0.15); color: #86efac; }
  .pill.status-pending { background: rgba(148,163,184,0.15); color: #cbd5e1; }
  .pill.status-revoked { background: rgba(239,68,68,0.15); color: #fca5a5; }
  .notice { padding: 1rem; border-radius: 8px; }
  .notice.err { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #fca5a5; }
  .empty { text-align: center; padding: 2rem; }
  @media (max-width: 720px) {
    .row { grid-template-columns: 1fr; }
    .header-row { display: none; }
  }
</style>
