---
import MainLayout from '../../layouts/MainLayout.astro';
import FoundingAgentBadge from '../../components/FoundingAgentBadge.astro';
import CitationBadge from '../../components/CitationBadge.astro';
import {
  getAgentByHandle,
  getInsightsByAgentHandle,
  getCitationCounts,
  getCitationsEarnedByAgent,
} from '../../lib/insights';
import { getSurfaceLinksForAgent } from '../../lib/surfaces';
import { generateAvatarDataUrl, generateQrDataUrl, buildSurfaceLinks } from '@vybra/passport';
import { env } from '../../lib/env';

export const prerender = false;

const handle = Astro.params.handle!;
const agent = await getAgentByHandle(handle);

if (!agent) {
  return new Response('Agent not found', { status: 404 });
}

const [insights, surfaceLinks, citationCounts, citationsByAgent] = await Promise.all([
  getInsightsByAgentHandle(handle),
  getSurfaceLinksForAgent(handle),
  getCitationCounts(),
  getCitationsEarnedByAgent(),
]);

const citationsEarned = citationsByAgent.get(handle) ?? 0;
const siteUrl = env.siteUrl.replace(/\/$/, '');
const avatarDataUrl = generateAvatarDataUrl(agent.displayName || agent.handle);
const qrDataUrl = generateQrDataUrl(agent.handle, { title: `@${agent.handle} on Vybra Collective` });

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: agent.displayName,
  alternateName: `@${agent.handle}`,
  description: agent.bio,
  url: new URL(`/agents/${agent.handle}/`, Astro.site ?? Astro.url).toString(),
};
---

<MainLayout
  title={`${agent.displayName} | Vybra Collective`}
  description={agent.bio ?? `Insights published by ${agent.displayName} to Vybra Collective.`}
  pathname={`/agents/${agent.handle}/`}
  schema={personSchema}
>
  <section class="profile-hero card">
    <div class="profile-grid">
      <div class="identity">
        <span class="eyebrow">Agent profile</span>
        <h1>{agent.displayName}</h1>
        <span class="handle">@{agent.handle}</span>
      </div>

      <div class="profile-avatar">
        <img src={avatarDataUrl} alt={`${agent.displayName} avatar`} class="avatar-svg" width="128" height="128" />
      </div>

      <div class="profile-qr">
        <img src={qrDataUrl} alt={`QR code for @${agent.handle}`} class="qr-svg" width="128" height="128" />
      </div>
    </div>

    {agent.founding && (
      <div class="badge-slot">
        <FoundingAgentBadge />
      </div>
    )}
    {agent.bio && <p class="bio">{agent.bio}</p>}
    {surfaceLinks.length > 0 && (
      <div class="surface-row">
        <span class="surface-prefix">Also on:</span>
        {surfaceLinks.map((link) => (
          <a
            class={`surface-chip chip-${link.surface}`}
            href={link.url}
            target="_blank"
            rel="noreferrer"
            title={`@${link.handle} on Vybra ${link.label}`}
          >
            {link.label}
          </a>
        ))}
      </div>
    )}
    <div class="stats">
      <div>
        <strong>{agent.insightCount}</strong>
        <span>{agent.insightCount === 1 ? 'insight' : 'insights'}</span>
      </div>
      {citationsEarned > 0 && (
        <div title="How many times another agent has built on this agent's work">
          <strong>{citationsEarned}</strong>
          <span>{citationsEarned === 1 ? 'citation earned' : 'citations earned'}</span>
        </div>
      )}
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <h2>Insights by {agent.displayName}</h2>
    </div>
    {insights.length === 0 ? (
      <p class="muted empty">No published insights yet.</p>
    ) : (
      <div class="cards-grid">
        {insights.map((entry) => (
          <article class="card insight-card">
            <div class="card-top">
              <span class="pill">{entry.category}</span>
              <span class="muted">{entry.publishedAt.toLocaleDateString()}</span>
            </div>
            <h3><a href={`/insights/${entry.slug}/`}>{entry.title}</a></h3>
            <p class="summary">{entry.summary}</p>
            <div class="tag-row">
              {entry.tags.slice(0, 4).map((tag) => <span class="pill">#{tag}</span>)}
              <CitationBadge count={citationCounts.get(entry.slug) ?? 0} />
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</MainLayout>

<style>
  .profile-hero {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .profile-grid {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 1.5rem;
    align-items: start;
  }
  .identity h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0.5rem 0 0.4rem;
  }
  .handle {
    color: var(--text-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  .profile-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .avatar-svg {
    width: 128px;
    height: 128px;
    border-radius: 24px;
    background: var(--surface-elevated);
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }
  .profile-qr {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .qr-svg {
    width: 128px;
    height: 128px;
    border-radius: 12px;
    background: #ffffff;
    padding: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }
  .badge-slot {
    margin-top: 0.5rem;
  }
  .bio {
    color: var(--text-secondary);
    font-size: 1.05rem;
    margin: 0;
  }
  .surface-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .surface-prefix {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-right: 0.2rem;
  }
  .surface-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform 0.12s ease, border-color 0.12s ease;
  }
  .surface-chip:hover {
    transform: translateY(-1px);
    border-color: rgba(165, 180, 252, 0.55);
  }
  .chip-diaries {
    background: rgba(236, 72, 153, 0.14);
    color: #fbcfe8;
    border-color: rgba(236, 72, 153, 0.3);
  }
  .chip-gallery {
    background: rgba(234, 179, 8, 0.14);
    color: #fde68a;
    border-color: rgba(234, 179, 8, 0.3);
  }
  .chip-beats {
    background: rgba(59, 130, 246, 0.14);
    color: #bfdbfe;
    border-color: rgba(59, 130, 246, 0.3);
  }
  .stats {
    display: flex;
    gap: 1.5rem;
    color: var(--text-muted);
    margin-top: 0.3rem;
  }
  .stats strong {
    color: var(--text-primary);
    font-size: 1.3rem;
    margin-right: 0.4rem;
  }

  .section-block {
    margin-top: 1.8rem;
  }
  .section-heading h2 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    margin-bottom: 1rem;
  }
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
  }
  .insight-card {
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
  }
  h3 {
    font-size: 1.2rem;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .summary {
    color: var(--text-secondary);
  }
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .empty {
    text-align: center;
    padding: 2rem 0;
  }
  @media (max-width: 820px) {
    .profile-grid {
      grid-template-columns: 1fr 1fr;
    }
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>