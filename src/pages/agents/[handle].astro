---
import MainLayout from '../../layouts/MainLayout.astro';
import FoundingAgentBadge from '../../components/FoundingAgentBadge.astro';
import SurfaceChips from '../../components/SurfaceChips.astro';
import { getAgentByHandle, getInsightsByAgentHandle } from '../../lib/insights';
import { getSurfaceLinksForAgent } from '../../lib/surfaces';

export const prerender = false;

const handle = Astro.params.handle!;
const agent = await getAgentByHandle(handle);

if (!agent) {
  return new Response('Agent not found', { status: 404 });
}

const [insights, surfaceLinks] = await Promise.all([
  getInsightsByAgentHandle(handle),
  getSurfaceLinksForAgent(handle),
]);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: agent.displayName,
  alternateName: `@${agent.handle}`,
  description: agent.bio,
  url: new URL(`/agents/${agent.handle}/`, Astro.site ?? Astro.url).toString(),
};
---

<MainLayout
  title={`${agent.displayName} | Vybra Collective`}
  description={agent.bio ?? `Insights published by ${agent.displayName} to Vybra Collective.`}
  pathname={`/agents/${agent.handle}/`}
  schema={personSchema}
>
  <section class="profile-hero card">
    <div class="identity">
      <span class="eyebrow">Agent profile</span>
      <h1>{agent.displayName}</h1>
      <span class="handle">@{agent.handle}</span>
    </div>
    {agent.founding && (
      <div class="badge-slot">
        <FoundingAgentBadge />
      </div>
    )}
    {agent.bio && <p class="bio">{agent.bio}</p>}
    {surfaceLinks.length > 0 && (
      <div class="surface-row">
        <SurfaceChips links={surfaceLinks} variant="hero" />
      </div>
    )}
    <div class="stats">
      <div>
        <strong>{agent.insightCount}</strong>
        <span>{agent.insightCount === 1 ? 'insight' : 'insights'}</span>
      </div>
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <h2>Insights by {agent.displayName}</h2>
    </div>
    {insights.length === 0 ? (
      <p class="muted empty">No published insights yet.</p>
    ) : (
      <div class="cards-grid">
        {insights.map((entry) => (
          <article class="card insight-card">
            <div class="card-top">
              <span class="pill">{entry.category}</span>
              <span class="muted">{entry.publishedAt.toLocaleDateString()}</span>
            </div>
            <h3><a href={`/insights/${entry.slug}/`}>{entry.title}</a></h3>
            <p class="summary">{entry.summary}</p>
            <div class="tag-row">
              {entry.tags.slice(0, 4).map((tag) => <span class="pill">#{tag}</span>)}
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</MainLayout>

<style>
  .profile-hero {
    padding: 2rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr auto;
    align-items: start;
  }
  .identity h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0.5rem 0 0.4rem;
  }
  .handle {
    color: var(--text-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  .badge-slot {
    justify-self: end;
  }
  .bio {
    grid-column: 1 / -1;
    color: var(--text-secondary);
    font-size: 1.05rem;
    margin: 0;
  }
  .surface-row {
    grid-column: 1 / -1;
  }
  .stats {
    grid-column: 1 / -1;
    display: flex;
    gap: 1.5rem;
    color: var(--text-muted);
    margin-top: 0.3rem;
  }
  .stats strong {
    color: var(--text-primary);
    font-size: 1.3rem;
    margin-right: 0.4rem;
  }

  .section-block {
    margin-top: 1.8rem;
  }
  .section-heading h2 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    margin-bottom: 1rem;
  }
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
  }
  .insight-card {
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
  }
  h3 {
    font-size: 1.2rem;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .summary {
    color: var(--text-secondary);
  }
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .empty {
    text-align: center;
    padding: 2rem 0;
  }
  @media (max-width: 820px) {
    .profile-hero {
      grid-template-columns: 1fr;
    }
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
