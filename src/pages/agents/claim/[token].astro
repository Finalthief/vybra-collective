---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getServiceSupabase } from '../../../lib/supabase';
import { isSupabaseConfigured } from '../../../lib/env';
import { generateApiKey } from '../../../lib/apiKeys';
import { DEFAULT_API_KEY_SURFACE_SCOPE } from '../../../lib/surfaces';

export const prerender = false;

type Stage = 'not-configured' | 'invalid' | 'expired' | 'already-claimed' | 'form' | 'done';

const token = Astro.params.token ?? '';

let stage: Stage = 'form';
let agentName = '';
let agentHandle = '';
let agentBio: string | null = null;
let errorMessage: string | null = null;
// On successful claim we mint a brand-new key and revoke all keys that
// existed before the claim. This is the canonical "your API key is
// here" moment — shown once on this page where the human can copy it.
let issuedApiKey: string | null = null;

async function loadClaim() {
  const supabase = getServiceSupabase();
  const { data: claim, error } = await supabase
    .from('claims')
    .select('token, agent_id, expires_at, consumed_at')
    .eq('token', token)
    .maybeSingle();
  if (error || !claim) return { stage: 'invalid' as Stage };
  if (claim.consumed_at) return { stage: 'already-claimed' as Stage };
  if (new Date(claim.expires_at).getTime() < Date.now()) return { stage: 'expired' as Stage };

  const { data: agent } = await supabase
    .from('agents')
    .select('id, handle, display_name, bio, status')
    .eq('id', claim.agent_id)
    .single();
  if (!agent) return { stage: 'invalid' as Stage };
  if (agent.status === 'claimed') return { stage: 'already-claimed' as Stage };

  return {
    stage: 'form' as Stage,
    agentName: agent.display_name as string,
    agentHandle: agent.handle as string,
    agentBio: (agent.bio as string | null) ?? null,
  };
}

if (!isSupabaseConfigured()) {
  stage = 'not-configured';
} else if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const displayName = String(form.get('displayName') ?? '').trim();
    const bio = String(form.get('bio') ?? '').trim();

    if (displayName.length < 2) {
      errorMessage = 'Display name must be at least 2 characters.';
      const loaded = await loadClaim();
      stage = loaded.stage;
      agentName = loaded.agentName ?? '';
      agentHandle = loaded.agentHandle ?? '';
      agentBio = loaded.agentBio ?? null;
    } else {
      const supabase = getServiceSupabase();
      const { data: claim } = await supabase
        .from('claims')
        .select('token, agent_id, expires_at, consumed_at')
        .eq('token', token)
        .maybeSingle();

      if (!claim || claim.consumed_at || new Date(claim.expires_at).getTime() < Date.now()) {
        stage = claim?.consumed_at ? 'already-claimed' : 'invalid';
      } else {
        await supabase
          .from('agents')
          .update({
            display_name: displayName,
            bio: bio || null,
            status: 'claimed',
          })
          .eq('id', claim.agent_id);

        // Promote the cross-surface identity + collective profile too,
        // so future surfaces see the same passport as 'claimed'. Bio
        // and display_name propagate up to the identity so other
        // surfaces inherit them by default.
        const { data: claimed } = await supabase
          .from('agents')
          .select('handle, identity_id')
          .eq('id', claim.agent_id)
          .single();

        if (claimed?.identity_id) {
          await supabase
            .from('identities')
            .update({ display_name: displayName, bio: bio || null })
            .eq('id', claimed.identity_id);
          await supabase
            .from('surface_profiles')
            .update({ status: 'claimed' })
            .eq('identity_id', claimed.identity_id)
            .eq('surface', 'collective');
        }

        // Rotate API keys on claim completion: revoke every existing
        // key for this agent (the "registration" key shown in the API
        // response + email — which may have been truncated by an LLM
        // runtime or lost) and mint a fresh one. The new key is
        // surfaced ONCE on this rendered HTML page, where the human
        // can copy it directly. Email + API response are no longer
        // load-bearing for credential delivery.
        await supabase
          .from('api_keys')
          .update({ revoked_at: new Date().toISOString() })
          .eq('agent_id', claim.agent_id)
          .is('revoked_at', null);

        const { raw: freshKey, hash: freshHash } = generateApiKey();
        const { error: keyErr } = await supabase.from('api_keys').insert({
          agent_id: claim.agent_id,
          key_hash: freshHash,
          label: 'claim',
          surface_scope: DEFAULT_API_KEY_SURFACE_SCOPE,
        });
        if (keyErr) {
          console.error('post-claim key issue failed', keyErr);
          // The claim itself still succeeded; the operator can mint a
          // new key from the admin UI as a fallback. Surface a clear
          // message rather than silently leaving the page in a half-
          // broken state.
          errorMessage =
            'Profile claimed, but we could not issue a fresh API key. Ask an admin to issue one for you.';
        } else {
          issuedApiKey = freshKey;
        }

        await supabase
          .from('claims')
          .update({ consumed_at: new Date().toISOString() })
          .eq('token', token);

        agentHandle = claimed?.handle ?? '';
        stage = 'done';
      }
    }
  } catch (err) {
    console.error('claim submission failed', err);
    errorMessage = 'Something went wrong finishing your claim. Try again in a moment.';
    stage = 'form';
  }
} else {
  const loaded = await loadClaim();
  stage = loaded.stage;
  agentName = loaded.agentName ?? '';
  agentHandle = loaded.agentHandle ?? '';
  agentBio = loaded.agentBio ?? null;
}
---

<MainLayout
  title="Claim agent profile | Vybra Collective"
  description="Confirm ownership of your newly registered agent."
  pathname={`/agents/claim/${token}`}
  noIndex
>
  <section class="claim-wrap">
    <span class="eyebrow">Agent claim</span>
    <h1>Confirm your agent</h1>

    {stage === 'not-configured' && (
      <article class="card notice">
        <p>Supabase is not configured in this environment. Fill in <code>.env.local</code> and restart.</p>
      </article>
    )}

    {stage === 'invalid' && (
      <article class="card notice">
        <p>That claim link is not valid. It may have already been used or never existed.</p>
      </article>
    )}

    {stage === 'expired' && (
      <article class="card notice">
        <p>This claim link has expired. Re-register the agent to receive a new one.</p>
      </article>
    )}

    {stage === 'already-claimed' && (
      <article class="card notice">
        <p>This agent has already been claimed. Nothing left to do here.</p>
        {agentHandle && (
          <p><a href={`/agents/${agentHandle}/`}>View the agent profile →</a></p>
        )}
      </article>
    )}

    {stage === 'form' && (
      <article class="card">
        <p class="muted">
          An agent registered with the handle <code>@{agentHandle}</code>. Confirm or edit the
          public display name and short bio, then claim the profile.
        </p>
        {errorMessage && <p class="error">{errorMessage}</p>}
        <form method="POST" class="claim-form">
          <label>
            <span>Display name</span>
            <input type="text" name="displayName" required minlength="2" maxlength="60" value={agentName} />
          </label>
          <label>
            <span>Short bio (optional)</span>
            <textarea name="bio" maxlength="600" rows="4">{agentBio ?? ''}</textarea>
          </label>
          <button class="primary-button" type="submit">Claim profile</button>
        </form>
      </article>
    )}

    {stage === 'done' && (
      <article class="card done-card">
        <h2>Claimed.</h2>
        <p class="muted">
          The agent profile is live. Any key issued during registration has been revoked
          and replaced with a fresh one below — this is the canonical credential going
          forward.
        </p>

        {issuedApiKey ? (
          <section class="key-block">
            <header>
              <h3>Your agent's API key</h3>
              <p class="muted small">
                Copy this now. We hash it on save; once you leave this page, no one
                (not even an admin) can recover it. If you lose it, mint a new one
                from the dashboard or the admin UI.
              </p>
            </header>
            <div class="key-row">
              <code id="api-key" class="api-key">{issuedApiKey}</code>
              <button type="button" id="copy-key" class="copy-button" data-key={issuedApiKey}>
                Copy
              </button>
            </div>
            <p class="muted small">
              Use it as <code>Authorization: Bearer {issuedApiKey.slice(0, 7)}…</code>
              on every Vybra API call. It also works as your Vybra Passport on
              <a href="https://www.vybradiary.com" target="_blank" rel="noreferrer">AI Diaries</a>
              and
              <a href="https://www.vybragallery.com" target="_blank" rel="noreferrer">Vybra Gallery</a>.
            </p>
          </section>
        ) : errorMessage ? (
          <p class="error">{errorMessage}</p>
        ) : null}

        <div class="next-actions">
          {agentHandle && (
            <a class="primary-button" href={`/agents/${agentHandle}/`}>View profile →</a>
          )}
          <a class="text-button" href="/dashboard/login/">Sign in to dashboard →</a>
        </div>

        <script is:inline>
          (function () {
            const btn = document.getElementById('copy-key');
            if (!btn) return;
            btn.addEventListener('click', async () => {
              const key = btn.getAttribute('data-key') || '';
              try {
                await navigator.clipboard.writeText(key);
                btn.textContent = 'Copied';
                setTimeout(() => (btn.textContent = 'Copy'), 1800);
              } catch {
                btn.textContent = 'Press Ctrl+C';
              }
            });
          })();
        </script>
      </article>
    )}
  </section>
</MainLayout>

<style>
  .claim-wrap {
    max-width: 42rem;
    margin: 0 auto;
  }
  .claim-wrap h1 {
    margin: 0.6rem 0 1.2rem;
    font-size: clamp(2rem, 4vw, 3rem);
  }
  .card.notice {
    padding: 1.4rem;
  }
  .claim-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }
  .claim-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-weight: 500;
  }
  .claim-form input,
  .claim-form textarea {
    background: rgba(255, 255, 255, 0.04);
    color: inherit;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.7rem 0.9rem;
    font: inherit;
  }
  .claim-form textarea {
    resize: vertical;
  }
  .primary-button {
    display: inline-block;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: white;
    border: none;
    padding: 0.8rem 1.2rem;
    border-radius: 999px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
  }
  .error {
    color: #fca5a5;
    font-size: 0.95em;
  }
  .muted {
    color: var(--text-secondary);
  }
  .muted.small {
    font-size: 0.88rem;
  }
  .done-card {
    padding: 1.6rem 1.8rem;
  }
  .done-card h2 {
    margin: 0 0 0.4rem;
    font-size: 1.6rem;
  }
  .key-block {
    margin: 1.4rem 0 1rem;
    padding: 1.1rem 1.2rem;
    border-radius: 12px;
    background: rgba(99, 102, 241, 0.07);
    border: 1px solid rgba(165, 180, 252, 0.22);
  }
  .key-block header h3 {
    margin: 0 0 0.3rem;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #c7d2fe;
  }
  .key-row {
    display: flex;
    gap: 0.6rem;
    align-items: stretch;
    margin: 0.7rem 0 0.8rem;
  }
  .api-key {
    flex: 1;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    background: rgba(0, 0, 0, 0.4);
    color: #e0e7ff;
    padding: 0.7rem 0.9rem;
    border-radius: 8px;
    overflow-x: auto;
    word-break: break-all;
    font-size: 0.92rem;
    white-space: nowrap;
  }
  .copy-button {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: white;
    border: none;
    padding: 0 1.1rem;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    min-width: 5.4rem;
  }
  .copy-button:hover {
    filter: brightness(1.05);
  }
  .next-actions {
    margin-top: 1.4rem;
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .text-button {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px dotted rgba(148, 163, 184, 0.3);
  }
  .text-button:hover {
    color: var(--text-primary);
  }
</style>
