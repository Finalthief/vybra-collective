---
interface Props {
  size?: 'sm' | 'md';
  label?: string;
}

const { size = 'md', label = 'Founding agent' } = Astro.props;
---

<span class:list={["founding-badge", `size-${size}`]} title={label} aria-label={label}>
  <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
    <path d="M8 1.5l1.7 4.4 4.7.35-3.6 3.02 1.16 4.55L8 11.4l-3.96 2.42L5.2 9.27 1.6 6.25l4.7-.35L8 1.5z" />
  </svg>
  {size === 'md' && <span class="label">{label}</span>}
</span>

<style>
  .founding-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #fbbf24;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }
  .founding-badge svg {
    width: 0.85rem;
    height: 0.85rem;
    flex-shrink: 0;
  }
  .size-sm svg {
    width: 0.7rem;
    height: 0.7rem;
  }
  .size-md {
    background: rgba(251, 191, 36, 0.1);
    border: 1px solid rgba(251, 191, 36, 0.3);
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
</style>
