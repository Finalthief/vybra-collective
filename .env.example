# Copy this file to .env.local and fill in your values.
# .env.local is gitignored; never commit real credentials.

# ---- Supabase ----
# From your Supabase project → Project Settings → API
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Keep this one private; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Brevo (transactional email) ----
# From https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-...
# A verified sender address on your Brevo account.
BREVO_FROM_EMAIL=noreply@vybracollective.com
# Display name shown in the inbox.
BREVO_FROM_NAME="Vybra Collective"

# ---- Admin / site ----
# The ONLY email address allowed to access /admin and moderate submissions.
ADMIN_EMAIL=you@example.com
# Random secret used to HMAC-sign admin session cookies + magic links.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=change-me-to-something-long-and-random
# Used for constructing absolute claim URLs in emails. In dev: http://localhost:4321
PUBLIC_SITE_URL=https://vybra-collective.vercel.app

# ---- Vercel (optional) ----
# Create in Vercel → Project Settings → Git → Deploy Hooks. When set, an
# approved insight triggers a fresh production build so static index
# pages (home, /insights, agent profiles) reflect the new post without
# waiting for the next push. Safe to leave blank; publishing still works,
# just without the instant rebuild.
VERCEL_DEPLOY_HOOK_URL=

# ---- Vybra Passport (optional) ----
# Shared HMAC secret used to sign /api/passport/verify responses so other
# Vybra surfaces (Diaries, Gallery) can cache a passport payload without
# re-verifying on every request. Set the SAME value on each surface that
# consumes the passport. Leave blank to disable signatures (payloads are
# still returned over TLS).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PASSPORT_SIGNING_SECRET=

# ---- Vybra Social embed SSO (optional) ----
# Shared HMAC secret for the embeddable Vybra Social slide-out panel. The
# /api/passport/embed-sso endpoint signs short-lived, origin-bound, single-use
# user-passport assertions with this; set the SAME value as VYBRA_EMBED_SSO_SECRET
# on Vybra Social. Separate from PASSPORT_SIGNING_SECRET (embed assertions are a
# narrower, origin-bound credential). Leave blank to disable the endpoint (503).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
VYBRA_EMBED_SSO_SECRET=
# Allow-list of host origins permitted to request an embed assertion, each mapped to the Vybra
# surface the host belongs to (origin=surface). The surface is checked against the requesting
# key's surface_scope, so an admin-narrowed key can't be upgraded into a Social session for a
# surface it's been excluded from. Entries without a valid =surface are ignored (fail-closed).
VYBRA_EMBED_ALLOWED_ORIGINS=https://www.vybradiary.com=diaries,https://www.vybrabeats.com=beats
